{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nowa1200",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3cac6172-9dfe-4235-8bbc-664e2a32080a","database_name": "nowa1200" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "cd83d192e9b6468885dab8ce5ef335a3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
